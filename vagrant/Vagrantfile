# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Despliegue desde cero en VirtualBox: mismas 4 VLANs, mismas IPs y mismos stacks Docker
# que la arquitectura documentada en ../docs/00-arquitectura.md. Ver vagrant/README.md.
#
#   vagrant up                 # router nftables + docker-host (todo automático)
#   vagrant up docker-host     # solo docker-host, si el router va a ser una OPNsense manual
#
# Variables opcionales: DOCKER_HOST_MEM (MB, default 10240), REPO_URL (fork propio).

Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64"
  config.vm.boot_timeout = 600

  # Sin carpetas compartidas: el box de Debian no trae Guest Additions de VirtualBox y en
  # Windows no hay rsync. docker-host clona el repo de GitHub durante el provisioning.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # --- router: Linux + nftables (NAT + segmentación + firewall por VLAN) ---
  config.vm.define "router" do |router|
    router.vm.hostname = "router"
    # vlan_wan = "internet simulada" (203.0.113.0/24, rango de documentación, RFC 5737):
    # ahí se conecta la VM atacante del Red Team. La NIC 1 (NAT de Vagrant) es aparte y
    # solo le da internet real al router para instalar paquetes.
    router.vm.network "private_network", virtualbox__intnet: "vlan_wan",  ip: "203.0.113.254", netmask: "255.255.255.0"
    router.vm.network "private_network", virtualbox__intnet: "vlan_srv",  ip: "10.10.10.254", netmask: "255.255.255.0"
    router.vm.network "private_network", virtualbox__intnet: "vlan_dmz",  ip: "10.10.20.254", netmask: "255.255.255.0"
    router.vm.network "private_network", virtualbox__intnet: "vlan_usr",  ip: "10.10.30.254", netmask: "255.255.255.0"
    router.vm.network "private_network", virtualbox__intnet: "vlan_mgmt", ip: "10.10.90.254", netmask: "255.255.255.0"
    router.vm.provision "shell", path: "provision-router.sh"
    router.vm.provider "virtualbox" do |vb|
      vb.name = "tarea3-router"
      vb.memory = 1024
      vb.cpus = 1
    end
  end

  # --- docker-host: todos los stacks, 1 NIC por VLAN ---
  config.vm.define "docker-host" do |dh|
    dh.vm.hostname = "docker-host"
    dh.vm.network "private_network", virtualbox__intnet: "vlan_srv",  ip: "10.10.10.5", netmask: "255.255.255.0"
    dh.vm.network "private_network", virtualbox__intnet: "vlan_dmz",  ip: "10.10.20.5", netmask: "255.255.255.0"
    dh.vm.network "private_network", virtualbox__intnet: "vlan_usr",  ip: "10.10.30.5", netmask: "255.255.255.0"
    dh.vm.network "private_network", virtualbox__intnet: "vlan_mgmt", ip: "10.10.90.5", netmask: "255.255.255.0"
    dh.vm.provision "shell", path: "provision-docker-host.sh",
      env: { "REPO_URL" => ENV.fetch("REPO_URL", "https://github.com/fmq203/TSI-2026-Infra.git") }
    dh.vm.provider "virtualbox" do |vb|
      vb.name = "tarea3-docker-host"
      vb.memory = ENV.fetch("DOCKER_HOST_MEM", "10240").to_i
      vb.cpus = 2
      # Los contenedores usan macvlan: cada uno tiene su propia MAC. Las redes internas de
      # VirtualBox descartan por defecto el tráfico hacia MACs que no son la de la VM, así
      # que sin esto ningún contenedor es alcanzable desde el router ni desde otra VM.
      # NIC 1 es el NAT de Vagrant; las 4 VLANs son las NIC 2 a 5.
      (2..5).each { |n| vb.customize ["modifyvm", :id, "--nicpromisc#{n}", "allow-all"] }
    end
  end
end
