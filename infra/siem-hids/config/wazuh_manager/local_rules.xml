<!--
  Reglas locales del laboratorio. configure-manager.sh copia este archivo a
  /var/ossec/etc/rules/local_rules.xml del manager (el repo es la fuente de verdad).
  IDs 100000-120000 = rango reservado por Wazuh para reglas de usuario.
-->
<group name="local,suricata,cu01,">

  <!-- CU-01: las firmas propias de Suricata (SIDs 1000001-1000005, nids/rules/local.rules)
       llegan como regla 86601 nivel 3. Se suben a nivel 10 para que cuenten como
       incidente: aparecen como "high" en el dashboard y disparan el mail al SOC. -->
  <rule id="100100" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id" type="pcre2">^100000[1-5]$</field>
    <description>CU-01 Reconocimiento contra la red interna: $(alert.signature) desde $(src_ip)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>
</group>

<group name="local,syscheck,cu03,">

  <!-- CU-03: archivo PHP agregado al webroot -->
  <rule id="100200" level="12">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">^/var/www/html/.*\.php$</field>
    <description>CU-03 Webshell: archivo PHP agregado al webroot: $(file)</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
  </rule>

</group>
<group name="cowrie,honeypot,">

  <!-- Cowrie: intento de autenticación SSH fallido -->
  <rule id="100110" level="8">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.login.failed</field>
    <description>Cowrie Honeypot - intento de inicio de sesión SSH fallido</description>
    <group>authentication_failed,ssh,honeypot,</group>
  </rule>

</group>
